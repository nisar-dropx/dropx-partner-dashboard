{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/lib/biometric/*": ["../../src/lib/biometric/*"],
      "@/lib/attendance-regularization-workflow": ["../../src/lib/attendance-regularization-workflow.ts"],
      "@/lib/connect-attendance-notifications": ["../../src/lib/connect-attendance-notifications.ts"],
      "@/lib/roster-plan-preference": ["../../src/lib/roster-plan-preference.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
