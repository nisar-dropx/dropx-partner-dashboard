<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Solid theme — Theme.Translucent.NoTitleBar caused launch flash/exit on some devices. -->
    <style name="Theme.OpsPulse.DayNight" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/navigation_color</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
