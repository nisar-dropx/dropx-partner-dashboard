<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- FirebaseMessagingService reads these for any push notification that doesn't
             explicitly set android.notification.icon/color itself (e.g. a plain data-only
             message, or one sent from Firebase Console directly) — without this, Android falls
             back to the app's full-color launcher icon shrunk into a plain white circle/blob,
             which is what showed up before this was added. ic_notification is the white
             silhouette generated from ic_launcher_foreground's brand mark. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/dropx_brand" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="dropx_one_notifications" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- DropxOnePlugin's background tracker: a separate always-alive process/service
             from the WebView, started/stopped by connect-native-bridge.tsx via
             startBackgroundLocation()/stopBackgroundLocation(). -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".location.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Replaces @capacitor/push-notifications' own MessagingService (removed just below)
             so a "Mark as read" action button can be added when the app is backgrounded —
             Android's default FCM handling (what @capacitor/push-notifications' service left in
             place would fall through to) renders a plain system notification straight from the
             message with no way to inject an action into it. tools:node="remove" is required:
             the plugin's AAR declares its own <service> for this same intent-filter, and without
             explicitly overriding it the manifest merger keeps BOTH, which would have delivered
             every push notification twice. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".notifications.DropxMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".notifications.MarkNotificationReadReceiver"
            android:exported="false" />

        <!-- Last-resort path for the "Mark as read" action — see the service's own comment for
             why DropxMessagingService alone isn't enough on this device. Requires the worker to
             separately grant "Notification access" in system Settings (MainActivity prompts for
             it once); BIND_NOTIFICATION_LISTENER_SERVICE is mandatory for the OS to trust this
             component at all. -->
        <service
            android:name=".notifications.DropxNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for the selfie/face-match punch flow (a plain getUserMedia() camera request
         from the website, not our native plugin) — without this declared here, the WebView's
         camera permission request is auto-denied with no OS prompt ever shown at all, which is
         exactly the "Camera permission denied" error the selfie screen shows immediately. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Normal (non-dangerous) permission, no runtime prompt — needed by
         LocationTrackingService.isVpnActive() to check for an active VPN transport. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
