# Copy this to keystore.properties (gitignored — never commit the real one) on any machine
# that needs to produce a signed release build. See ../README.md's Signing section for where
# the actual keystore file and its password are stored for this project.
storeFile=../../../../../private/dropx-tracker-android/dropx-tracker-release.keystore
storePassword=REPLACE_ME
keyAlias=dropx-tracker-release
keyPassword=REPLACE_ME
