{
  "manifest_version": 2,
  "name": "DropX Site Summary Monitor",
  "version": "1.0.0",
  "description": "Monitors acceptance time across all dark stores and sends WhatsApp alerts via Report Bot.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "<all_urls>",
    "https://eu.store-management.f3.amazon.dev/*",
    "https://dropx-report-bot.onrender.com/*"
  ],

  "background": {
    "scripts": ["config.js", "config.local.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["https://eu.store-management.f3.amazon.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "dropx-site-summary@dropxlogistics.com",
      "strict_min_version": "109.0"
    }
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-off.png",
      "48": "icons/icon-off-48.png",
      "128": "icons/icon-off-128.png"
    },
    "default_title": "DropX Monitor"
  },

  "icons": {
    "32": "icons/icon-off.png",
    "48": "icons/icon-off-48.png",
    "128": "icons/icon-off-128.png"
  }
}
