{
  "name": "nl-loss-cloak-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that pulls NL loss (Cloak bulk download) and SLP loss (Amazon SLP Initial/Final Recovery files) into Supabase for the Ops Pulse Team Ops pages.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "@zip.js/zip.js": "^2.8.45",
    "hono": "^4.6.9",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.116.0"
  }
}
