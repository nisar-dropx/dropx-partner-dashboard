# Ops portal address the worker reports to.
PORTAL_URL=https://ops.dropxlogistics.com

# Created in Ops Pulse → Report Bot → Connection → Create token. Shown once.
WORKER_TOKEN=

# Public HTTPS name for this worker (docker-compose Caddy). Save the same address in the portal.
WORKER_DOMAIN=wa-bot.dropxlogistics.com

# Name shown in WhatsApp → Linked devices.
DEVICE_NAME=DropX Report Bot

# How long downloaded images stay on the worker for the portal to fetch.
MEDIA_TTL_HOURS=48
LOG_LEVEL=info
