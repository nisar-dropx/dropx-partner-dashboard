# Copy from Ops Pulse → Settings → Report Bot setup (or download a filled-in .env there).
WORKER_TOKEN=

# Optional. Defaults to https://ops.dropxlogistics.com
PORTAL_URL=https://ops.dropxlogistics.com

# Only for docker compose on your own server (HTTPS via Caddy).
WORKER_DOMAIN=wa-bot.dropxlogistics.com

# Name shown in WhatsApp → Linked devices.
DEVICE_NAME=DropX Report Bot
LOG_LEVEL=info
