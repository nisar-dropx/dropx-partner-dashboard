# Copy to .env.station-summary (gitignored). Use on each laptop that monitors WorkSpaces.
# For the standalone pack, copy to workspaces-site-summary-monitor/worker/.env.station-summary

AMAZON_CHECK_INTERVAL_MINUTES=1
AMAZON_MIN_RED_PIXELS=80
AMAZON_MIN_CAPTURE_WIDTH=800
AMAZON_MIN_CAPTURE_HEIGHT=500
AMAZON_ALERT_COOLDOWN_MINUTES=5
SCREEN_LOCK_ALERT_COOLDOWN_MINUTES=15

# DropX stores — cycle one-by-one; WhatsApp only when Acceptance Time > SLA
AMAZON_STATIONS=TCC3,TCD4,TTB3,TTA5,TZC4,TTG9,TFB7
AMAZON_STATION_FILTERS=TCC3:TCC3,TCD4:TCD4_SS,TTB3:TTB3,TTA5:TTA5,TZC4:TZC4,TTG9:TTG9_SS,TFB7:TFB7_SS
AMAZON_STATION_DROPDOWN_SUFFIX=
AMAZON_STATION_CHIP_PREFIX=AmazonNow

# Per-station Live war rooms (Report Bot Groups → wa_group_id)
AMAZON_STATION_GROUP_JIDS=TCC3:120363424408130632@g.us,TCD4:120363407865525845@g.us,TTB3:120363424079156767@g.us,TTA5:120363425009535873@g.us,TZC4:120363411844052790@g.us,TTG9:120363427914569852@g.us,TFB7:120363432925308998@g.us

# Quiet PrintWindow capture. Dropdown switch uses scripts (NOT AI); Background restores focus.
AMAZON_MONITOR_QUIET=1
AMAZON_STATION_SWITCH_MODE=Dropdown
AMAZON_SWITCH_BACKGROUND=1
# Reload wait happens AFTER focus returns (so Cursor/other apps are not blocked).
AMAZON_STATION_SWITCH_WAIT_MS=4500
AMAZON_STATION_SWITCH_WAIT_OVERRIDES=TFB7:8000,TTG9:6500,TCD4:5500
AMAZON_WS_DROP_X=0.935
AMAZON_WS_DROP_Y=0.195
# Prevents the remote WorkSpaces Windows VM from idle-locking (cloud lock screen).
# Leave ON on the dedicated monitor laptop.
AMAZON_WS_KEEPALIVE=1
AMAZON_WS_KEEPALIVE_SECONDS=180

# Gemini fills worst-clock / pending count AFTER red-pixel issue signal. Set 0 for no AI.
AMAZON_USE_GEMINI=1
AMAZON_SITE_SUMMARY_URL=https://eu.store-management.f3.amazon.dev/siteSummary
AMAZON_ALERT_METRIC=acceptance_time
ACCEPTANCE_TIME_THRESHOLD_SECONDS=15
SCREEN_LOCK_ALERT_PHONE=919645881397

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ops Pulse → Report Bot (Dark Store) → Setup: worker URL + token
WHATSAPP_WORKER_URL=https://dropx-report-bot.onrender.com
WHATSAPP_WORKER_TOKEN=rbw_your_token
# Fallback only if a station JID is missing from AMAZON_STATION_GROUP_JIDS
DARK_STORE_OPS_GROUP_JID=120xxxxxxxxxxxxx@g.us
