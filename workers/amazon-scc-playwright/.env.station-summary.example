# Copy to .env.station-summary (gitignored). Use on each laptop that monitors WorkSpaces.

# Host-side capture (recommended when WorkSpaces file copy is blocked)
AMAZON_CHECK_INTERVAL_MINUTES=1
AMAZON_MIN_RED_PIXELS=80
AMAZON_MIN_CAPTURE_WIDTH=400
AMAZON_MIN_CAPTURE_HEIGHT=300
AMAZON_ALERT_COOLDOWN_MINUTES=5
AMAZON_ACTIVE_STATION=TCD4_SS
AMAZON_STATIONS=TCD4_SS,STORE_2,STORE_3,STORE_4,STORE_5

# Gemini caption + metric break-up question (Vision reads the screenshot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Dark Store Ops via existing report-bot worker
# Ops Pulse → Report Bot (Dark Store) → Setup: copy worker URL + token
# Groups tab: copy the Dark Store Ops wa_group_id (ends with @g.us)
WHATSAPP_WORKER_URL=https://your-dropx-report-bot.onrender.com
WHATSAPP_WORKER_TOKEN=rbw_your_token
DARK_STORE_OPS_GROUP_JID=120xxxxxxxxxxxxx@g.us
